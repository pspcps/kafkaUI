# Copy to .env and supply your own secrets. Never commit .env.
# Generate JWT_SECRET and WORKER_API_TOKEN independently: openssl rand -hex 32
POSTGRES_DB=kafbat
POSTGRES_USER=kafbat
POSTGRES_PASSWORD=
MONGO_PASSWORD=
JWT_SECRET=
JWT_TTL=8h
KAFBAT_ADMIN_USER=admin
KAFBAT_ADMIN_PASSWORD=
WORKER_API_TOKEN=

# Bundled Kafka: docker compose --profile local up --build
KAFKA_BOOTSTRAP=kafka:9093
KAFKA_CLUSTER_NAME=Local
KAFKA_AUTH_TYPE=none

# For a remote Kafka cluster, replace KAFKA_BOOTSTRAP and set auth as needed:
# KAFKA_AUTH_TYPE=msk_iam | sasl_plain | sasl_scram | none
# KAFKA_TLS=true
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_AWS_REGION=
# Prefer AWS workload identity/default credential chain over static keys.
# Backend authentication modes do not yet apply to replication workers.

# Browser API URL is compiled into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Worker setup and Kubernetes Secret requirements:
# docs/ENTERPRISE_READINESS.md

# Optional operator-owned profile file; required for new replication jobs.
# CONNECTION_PROFILES_FILE=/etc/kafkaui/connections.json
# See config/connections.example.json and docs/MANAGED_CONNECTIONS.md

# Operator delivery policy; forwarded to newly created worker pods.
# See docs/DELIVERY_CONTRACT.md before selecting dead_letter.
DELIVERY_FAILURE_POLICY=pause
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_SECONDS=0.5
DELIVERY_RETRY_CAP_SECONDS=5
# DELIVERY_DLQ_TOPIC=preprovisioned-failures
DELIVERY_DLQ_TIMEOUT_SECONDS=10
